{
  "name": "json-edit-react",
  "version": "2.0.0-beta.10",
  "description": "React component for editing or viewing JSON/object data",
  "main": "build/index.cjs.js",
  "module": "build/index.esm.js",
  "types": "build/index.d.ts",
  "sideEffects": [
    "./build/style.css"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.esm.js",
      "require": "./build/index.cjs.js",
      "default": "./build/index.esm.js"
    },
    "./style.css": "./build/style.css"
  },
  "files": [
    "build/**/*"
  ],
  "repository": "https://github.com/CarlosNZ/json-edit-react.git",
  "author": "Carl Smith <5456533+CarlosNZ@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://carlosnz.github.io/json-edit-react",
  "packageManager": "pnpm@10.8.1",
  "publishConfig": {
    "directory": "build_package",
    "linkDirectory": false
  },
  "scripts": {
    "setup": "pnpm install && cd demo && yarn install",
    "test": "jest",
    "bench": "node --expose-gc node_modules/jest/bin/jest.js --runInBand -c jest.bench.config.mjs",
    "dev": "cd demo && yarn && yarn dev",
    "demo": "cd demo && yarn && yarn start",
    "demo:pack": "pnpm pack-all && cd demo && yarn && yarn start:pack",
    "prebuild": "pnpm lint && node scripts/run-prebuild-tests.mjs",
    "build": "rollup -c && rm -R build/dts && node scripts/verify-treeshake.mjs",
    "build-all": "pnpm -r build",
    "build-package": "pnpm build && node scripts/stage-package.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile": "tsc --noEmit && ts-prune",
    "preview-publish": "pnpm build-package && cd build_package && pnpm pack --pack-destination ..",
    "pack-all": "node scripts/pack-all.mjs",
    "bump:core:beta": "npm version prerelease --preid=beta",
    "bump:utils:beta": "cd packages/utils      && npm version prerelease --preid=beta --tag-version-prefix=@json-edit-react/utils@",
    "bump:themes:beta": "cd packages/themes     && npm version prerelease --preid=beta --tag-version-prefix=@json-edit-react/themes@",
    "bump:components:beta": "cd packages/components && npm version prerelease --preid=beta --tag-version-prefix=@json-edit-react/components@",
    "pub:core:beta": "pnpm build-package && pnpm publish --tag beta --no-git-checks",
    "pub:core:latest": "pnpm build-package && pnpm publish --no-git-checks",
    "pub:utils": "cd packages/utils      && node ../../scripts/with-npm-readme.mjs . -- pnpm publish --access public --no-git-checks",
    "pub:themes": "cd packages/themes     && node ../../scripts/with-npm-readme.mjs . -- pnpm publish --access public --no-git-checks",
    "pub:components": "cd packages/components && node ../../scripts/with-npm-readme.mjs . -- pnpm publish --access public --no-git-checks",
    "versions": "node scripts/versions.mjs",
    "release-demo": "cd demo && yarn deploy",
    "sync-demos": "node scripts/installLatestPackage.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "19.1.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.9.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.3",
    "rollup-plugin-bundle-size": "^1.0.3",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-sizes": "^1.1.0",
    "rollup-plugin-styles": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-prune": "^0.10.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "csstype": "3.1.3",
      "@types/react": "19.1.1"
    }
  },
  "keywords": [
    "react",
    "component",
    "components",
    "interactive",
    "interactive-json",
    "json",
    "json-component",
    "json-display",
    "json-tree",
    "json-viewer",
    "json-inspector",
    "json-schema",
    "json-editor",
    "editor",
    "data-viewer",
    "form-builder",
    "drag-and-drop",
    "customizable",
    "typescript",
    "react-component",
    "react-json",
    "theme",
    "tree-view",
    "treeview",
    "react-json-view"
  ]
}
