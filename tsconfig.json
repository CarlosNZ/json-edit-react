{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "build/dts",
    "lib": ["dom", "es2020"],
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": "src",
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "removeComments": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // "include": ["src"]
  // `src/css.d.ts` declares the `*.css` modules; ambient declarations are
  // only in the program if they're root files, and there's no `include` glob
  // here to pick it up.
  "files": ["src/index.ts", "src/css.d.ts"]
  // "include": ["src/types.ts"]
}
